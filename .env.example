# Copia in .env (ignorato da git) e compila: scripts/build-arch.sh include questi valori nel binario.
# Microsoft Entra → Registrazioni app → ID applicazione (client)
MISSIVA_MICROSOFT_CLIENT_ID=
# Google Cloud Console → Credenziali → ID client OAuth di tipo "App desktop"
MISSIVA_GOOGLE_CLIENT_ID=
MISSIVA_GOOGLE_CLIENT_SECRET=
